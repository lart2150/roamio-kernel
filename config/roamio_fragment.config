# Appended to bcm7429b0_defconfig. Every line is here to match the device kernel (3.3.8-2.5);
# derived from device kallsyms vs our System.map (tivo-image roamio/kernel-sym-diff.md).
# vermagic "3.3.8-2.5 SMP mod_unload BMIPS 32BIT": SMP, module unload, no modversions, no PREEMPT
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODVERSIONS is not set
CONFIG_SMP=y
CONFIG_CPU_LITTLE_ENDIAN=y
# CONFIG_PREEMPT is not set

# --- struct-layout relevant (lock sizes, page/highmem, device PM, skb/netdev) ---
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_SPINLOCK=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_HIGHMEM=y
CONFIG_PM_RUNTIME=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=y
CONFIG_NET_SCH_PRIO=y
CONFIG_NET_SCH_SFQ=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_U32=y
# scatterlist +4 at offset 0 is a TiVo pad (patches/tivo-layout.patch), not DEBUG_SG: the device
# never sets or checks SG_MAGIC
# CONFIG_DEBUG_SG is not set
# usb_device.usb_classdev (-4 from 0x2ec) -- whole-kernel offset diff
# CONFIG_USB_DEVICE_CLASS is not set
CONFIG_LOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SCHEDSTATS=y
CONFIG_TIMER_STATS=y
CONFIG_STACKTRACE=y
# CONFIG_HIGH_RES_TIMERS is not set
CONFIG_NETFILTER_XT_MATCH_LENGTH=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_NF_TARGET_REJECT=y
# CONFIG_NF_CONNTRACK_PROCFS is not set

# --- device-only code ---
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_EXT2_FS=y
CONFIG_EXT3_FS=y
# CONFIG_EXT3_FS_XATTR is not set
CONFIG_ROMFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_LEGACY_PTYS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MAC_PARTITION=y
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
# CONFIG_DEVTMPFS is not set
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_EEM=y
# CONFIG_USB_NET_CDCETHER is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
CONFIG_TUN=y
CONFIG_USB_SERIAL=y
CONFIG_SYSCTL_SYSCALL=y
CONFIG_XZ_DEC=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA256=y

# --- shipped as modules on the device (platform/lib/modules) ---
CONFIG_INPUT=m
CONFIG_INPUT_EVDEV=m
CONFIG_HID=m
CONFIG_USB_HID=m
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_PEGASUS=m
CONFIG_USB_RTL8150=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL_FTDI_SIO=m

# --- built by defconfig, absent on the device ---
# CONFIG_MTD is not set
# CONFIG_SPI is not set
# CONFIG_BRCM_MOCA is not set
# CONFIG_EXT4_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_BRIDGE is not set
# CONFIG_LLC is not set
# CONFIG_IP_PNP is not set
# CONFIG_VT is not set
# CONFIG_USB_MON is not set
# CONFIG_IOSCHED_DEADLINE is not set
# CONFIG_IOSCHED_CFQ is not set
# CONFIG_DYNAMIC_DEBUG is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_USB_NET_CDC_NCM is not set
